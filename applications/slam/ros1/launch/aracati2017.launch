<!-- Aracati 2017: the bag + dead reckoning (aracati2017 odom node) + DISO + Sonar Context SLAM.
     roslaunch sonar_context_slam aracati2017.launch bag:=/data/ARACATI_2017_8bits_full.bag save_dir:=/data/out -->
<launch>
  <arg name="bag" />
  <arg name="save_dir" default="" />
  <arg name="rate" default="0.8" />
  <arg name="start" default="0" />
  <arg name="rviz" default="false" />
  <!-- record the sonar images, DISO's poses and the ground truth (e.g. to replay them on ROS 2) -->
  <arg name="record" default="" />
  <param name="use_sim_time" value="true" />

  <node pkg="tf" type="static_transform_publisher" name="world2odom"
        args="0 0 0 0 0 0 1 odom orb_slam 100" />
  <!-- dead reckoning from /cmd_vel: DISO's motion prior (/odom_pose) -->
  <node pkg="aracati2017" type="odom" name="odom" output="log">
    <remap from="/pose" to="/pose_gt" />
    <param name="odom_frame_id" value="odom" />
    <param name="base_frame_id" value="son" />
  </node>
  <node pkg="direct_sonar_odometry" type="aracati2017_node" name="direct_sonar_odometry_node" output="log"
        args="$(find direct_sonar_odometry)/config/config_aracati2017.yaml" />

  <node pkg="sonar_context_slam" type="sonar_context_slam_node" name="sonar_context_slam" output="screen">
    <rosparam command="load" file="$(find sonar_context_slam)/config/aracati2017.yaml" />
    <param name="save_dir" value="$(arg save_dir)" />
  </node>

  <node if="$(eval record != '')" pkg="rosbag" type="record" name="record" output="log"
        args="-O $(arg record) /son/compressed /direct_sonar/pose /pose_gt" />
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz" args="-d $(find sonar_context_slam)/launch/slam.rviz" />
  <node pkg="rosbag" type="play" name="play" required="true" output="log"
        args="$(arg bag) --clock -r $(arg rate) -s $(arg start) -q" />
</launch>
